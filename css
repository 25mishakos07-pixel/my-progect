body{
  font-family: sans-serif;
  margin: 0;
  
}

body {
    background-color: #313131; / Темно-сірий фон /
    background-image: url('data:image/jpeg;base64,'); 
    color: #f0f0f0;
    font-family: "Segoe UI", Tahoma, sans-serif;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

header {
    background: #4da432 url('https://www.transparenttextures.com/patterns/pinstriped-suit.png');
    width: 100%;
    padding: 50px 0;
    text-align: center;
    border-bottom: 10px solid #2d5a1a;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}

header h1 {
    font-size: 3rem;
    margin: 0;
    color: #fff;
    text-shadow: 4px 4px 0px #222;
    letter-spacing: 3px;
}

header p {
    font-size: 1.2rem;
    color: #e0e0e0;
    margin-top: 10px;
}

main {
    max-width: 900px;
    width: 95%;
    padding: 40px 0;
}.card {
    background-color: #4a4a4a;
    border: 6px solid #1e1e1e;
    margin-bottom: 50px;
    box-shadow: 10px 10px 0px rgba(0,0,0,0.3);
    overflow: hidden;
}

.card-header {
    background-color: #3a3a3a;
    padding: 15px;
    border-bottom: 4px solid #1e1e1e;
}

.card h2 {
    margin: 0;
    color: #55ff55;
    text-shadow: 2px 2px 0px #000;
}

.image-container {
    width: 100%;
    border-bottom: 4px solid #1e1e1e;
}

.image-container img {
    width: 100%;
    display: block;
    image-rendering: pixelated;
    transition: transform 0.3s ease;
}

.image-container img:hover {
    transform: scale(1.02);
}

.card-text {
    padding: 25px;
    background-color: #444;
}

.card-text p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
}.actions {
    text-align: center;
    padding: 20px;
}

.btn-play {
    display: inline-block;
    background-color: #4da432;
    color: white;
    text-decoration: none;
    padding: 25px 60px;
    font-size: 2rem;
    font-weight: bold;
    border: 5px solid #ffffff;
    box-shadow: 0 8px 0 #2d5a1a, 0 15px 20px rgba(0,0,0,0.4);
    transition: all 0.1s;
    cursor: pointer;
}

.btn-play:hover {
    background-color: #5ccb3b;
    transform: translateY(2px);
    box-shadow: 0 6px 0 #2d5a1a, 0 10px 15px rgba(0,0,0,0.4);
}

.btn-play:active {
    transform: translateY(8px);
    box-shadow: 0 0px 0 #2d5a1a;
}

footer {
    padding: 30px;
    color: #888;
    font-size: 0.9rem;
}



.house { border-color: #4da432; }
.cave { border-color: #5555ff; }
.nether { border-color: #ff5555; }


 .video-link {
        display: inline-block;
        padding: 5px 10px;
        background-color: #ff0000; 
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 14px;
        text-align: center;
         padding: 20px;
    }
    .video-link:hover {
        background-color: #cc0000;
    }
    
    
    
    
    
    
    
    
    
    
    
    
    
    
